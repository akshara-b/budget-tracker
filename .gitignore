# Budget AI - GitIgnore Configuration
# Comprehensive gitignore for React + Python (FastAPI) full-stack application

# ===== GENERAL =====
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride

# Windows
$RECYCLE.BIN/
Desktop.ini

# Linux
*~
.nfs*

# ===== IDE & EDITOR =====
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# JetBrains IDEs
.idea/
*.swp
*.swo
*~

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# ===== CLIENT (React/Vite) =====
# Dependencies
client/node_modules/
client/.pnp
client/.pnp.js

# Production builds
client/dist/
client/build/

# Environment variables
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local

# Logs
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*
client/lerna-debug.log*

# Runtime data
client/pids
client/*.pid
client/*.seed
client/*.pid.lock

# Coverage directory used by tools like istanbul
client/coverage/
client/*.lcov

# Vite cache
client/.vite/

# ESLint cache
client/.eslintcache

# Stylelint cache
client/.stylelintcache

# Microbundle cache
client/.rpt2_cache/
client/.rts2_cache_cjs/
client/.rts2_cache_es/
client/.rts2_cache_umd/

# Optional npm cache directory
client/.npm

# Optional eslint cache
client/.eslintcache

# Optional REPL history
client/.node_repl_history

# Output of 'npm pack'
client/*.tgz

# Yarn Integrity file
client/.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
client/.cache
client/.parcel-cache

# Next.js build output
client/.next
client/out

# Nuxt.js build / generate output
client/.nuxt
client/dist

# Storybook build outputs
client/.out
client/.storybook-out
client/storybook-static

# Temporary folders
client/tmp/
client/temp/

# ===== SERVER (Python/FastAPI) =====
# Byte-compiled / optimized / DLL files
server/__pycache__/
server/**/__pycache__/
server/*.py[cod]
server/**/*.py[cod]
server/*$py.class
server/**/*$py.class

# C extensions
server/*.so

# Distribution / packaging
server/.Python
server/build/
server/develop-eggs/
server/dist/
server/downloads/
server/eggs/
server/.eggs/
server/lib/
server/lib64/
server/parts/
server/sdist/
server/var/
server/wheels/
server/pip-wheel-metadata/
server/share/python-wheels/
server/*.egg-info/
server/.installed.cfg
server/*.egg
server/MANIFEST

# PyInstaller
server/*.manifest
server/*.spec

# Installer logs
server/pip-log.txt
server/pip-delete-this-directory.txt

# Unit test / coverage reports
server/htmlcov/
server/.tox/
server/.nox/
server/.coverage
server/.coverage.*
server/.cache
server/nosetests.xml
server/coverage.xml
server/*.cover
server/*.py,cover
server/.hypothesis/
server/.pytest_cache/

# Translations
server/*.mo
server/*.pot

# Django stuff (if applicable):
server/*.log
server/local_settings.py
server/db.sqlite3
server/db.sqlite3-journal

# Flask stuff (if applicable):
server/instance/
server/.webassets-cache

# Scrapy stuff (if applicable):
server/.scrapy

# Sphinx documentation
server/docs/_build/

# PyBuilder
server/target/

# Jupyter Notebook
server/.ipynb_checkpoints

# IPython
server/profile_default/
server/ipython_config.py

# pyenv
server/.python-version

# pipenv
server/Pipfile.lock

# PEP 582
server/__pypackages__/

# Celery stuff
server/celerybeat-schedule
server/celerybeat.pid

# SageMath parsed files
server/*.sage.py

# Spyder project settings
server/.spyderproject
server/.spyproject

# Rope project settings
server/.ropeproject

# mkdocs documentation
server/site

# mypy
server/.mypy_cache/
server/.dmypy.json
server/dmypy.json

# Pyre type checker
server/.pyre/

