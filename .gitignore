# Model files (if you store trained models)
*.pkl
*.joblib
*.h5
*.pb
models/
checkpoints/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# ===== DOCUMENTATION =====
# Generated documentation
docs/_build/
docs/build/

# ===== TESTING =====
