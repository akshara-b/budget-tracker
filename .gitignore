coverage/
.nyc_output/

# Test results
test-results/
junit.xml

# ===== MISC =====
# Archive files
*.zip
*.tar.gz
*.rar

# Backup files
*.backup
*.bak
*.swp

# Lock files (except package-lock.json for consistency)
yarn.lock
pnpm-lock.yaml

# Local configuration files
config.local.json
settings.local.json

# ===== PROJECT SPECIFIC =====
# Sample data files (keep structure, ignore actual data)
server/sample_data.json
server/test_data.json

# Generated reports
reports/
exports/

# User uploads (if any)
uploads/
user_files/

# API documentation generated files
api_docs/
swagger-ui/
